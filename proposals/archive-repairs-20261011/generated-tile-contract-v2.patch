+"""Generator archive contracts. Point-only observations never imply paired roofs or appearance."""
+import math
+import re
+
+SCHEMA = 'earthcraft.generated-tile-shard.v1'
+SCHEMA_V2 = 'earthcraft.generated-tile-shard.v2'
+INDEX_SCHEMAS = {'earthcraft.generated-tile-index.v1', 'earthcraft.generated-tile-index.v2'}
+ENTRY_KEYS = {'tile', 'quality', 'world_offset_xz', 'size_m', 'metres_per_block',
+              'receipt_sha256', 'region_sha256', 'region_file', 'chunks',
+              'source_grid', 'scan', 'roof_source_cells',
+              'real_facade_photo_colors_applied', 'client_visual_verified', 'privacy_audit'}
+ENTRY_KEYS_V2 = ENTRY_KEYS | {'point_evidence'}
+PRIVACY = 'Generator-only region; no entities, block entities, players or local metadata'
+FEATURES = {'LQ': frozenset(), 'scan-roof': frozenset({'paired_roofs'}),
+            'classified-scan-points': frozenset({'classified_points'}),
+            'scan-points-and-roof': frozenset({'paired_roofs', 'classified_points'})}
+POINT_KEYS = {'schema', 'project', 'source_manifest_sha256', 'points_sha256',
+              'point_geometry_sha256', 'point_voxels_sha256', 'block_verification_sha256', 'building_points',
+              'occupied_voxels', 'retained_classes', 'output_horizontal_crs', 'grid',
+              'vertical_reference', 'ground_reference', 'datum_status',
+              'ground_comparison_points', 'median_absolute_ground_residual_m',
+              'all_intersecting_octree_levels_acquired', 'downsampling',
+              'independent_accuracy_verified', 'facade_colour_measured', 'source_asset_hashes'}
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def integer(value, minimum=0, maximum=None):
+    return type(value) is int and value >= minimum and (maximum is None or value <= maximum)
+
+
+def finite(value):
+    return type(value) in (int, float) and math.isfinite(value)
+
+
+def checksum(value):
+    return isinstance(value, str) and re.fullmatch('[a-f0-9]{64}', value) is not None
+
+
+def validate_point_evidence(value, frame=None):
+    require(isinstance(value, dict) and set(value) == POINT_KEYS, 'Exact point-only evidence required')
+    require(value['schema'] == 'earthcraft.point-only-evidence.v1', 'Point evidence schema differs')
+    require(isinstance(value['project'], str) and 0 < len(value['project']) <= 256 and
+            value['project'] not in {'.', '..'} and '/' not in value['project'] and '\\' not in value['project'],
+            'Public point project identity required')
+    for key in ['source_manifest_sha256', 'points_sha256', 'point_geometry_sha256', 'point_voxels_sha256',
+                'block_verification_sha256']:
+        require(checksum(value[key]), 'Point-source hash required: ' + key)
+    require(integer(value['building_points'], 1) and integer(value['occupied_voxels'], 1, 2_000_000) and
+            value['occupied_voxels'] <= value['building_points'], 'Actual positive point/voxel counts required')
+    require(value['retained_classes'] == [6] and type(value['retained_classes'][0]) is int,
+            'Point-only profile requires provider class-6 observations')
+    require(isinstance(value['output_horizontal_crs'], str) and value['output_horizontal_crs'], 'Point CRS required')
+    grid = value['grid']
+    require(isinstance(grid, dict) and set(grid) == {'crs', 'west', 'north', 'size'} and
+            grid['crs'] == value['output_horizontal_crs'] and type(grid['size']) is int and grid['size'] == 512 and
+            finite(grid['west']) and finite(grid['north']), 'Point grid differs')
+    if frame is not None:
+        require(grid['crs'] == frame.get('crs'), 'Point/output frame CRS differs')
+    require(value['ground_reference'] == 'LQ AWS terrain; absolute scan datum unverified' and
+            value['datum_status'] == 'absolute_vertical_datum_unverified' and
+            value['vertical_reference'] == 'Original EPT Z; metre interpretation checked against ' +
+            value['ground_reference'],
+            'Point-only datum uncertainty must remain explicit')
+    require(integer(value['ground_comparison_points'], 20) and
+            finite(value['median_absolute_ground_residual_m']) and
+            0 <= value['median_absolute_ground_residual_m'] <= 2, 'Measured ground comparison required')
+    require(value['all_intersecting_octree_levels_acquired'] is True and value['downsampling'] is False,
+            'Full-density point acquisition required')
+    require(value['independent_accuracy_verified'] is False and value['facade_colour_measured'] is False,
+            'Unsupported accuracy/appearance claim')
+    require(isinstance(value['source_asset_hashes'], list) and value['source_asset_hashes'] and
+            all(checksum(item) for item in value['source_asset_hashes']), 'Original point asset identities required')
+
+
+def validate_entry(item, schema=SCHEMA, frame=None):
+    keys = ENTRY_KEYS if schema == SCHEMA else ENTRY_KEYS_V2 if schema == SCHEMA_V2 else None
+    require(keys is not None and isinstance(item, dict) and set(item) == keys, 'Exact generated tile metadata required')
+    require(isinstance(item['tile'], str) and re.fullmatch(r'-?\d+_-?\d+', item['tile']), 'Tile identity required')
+    quality = item['quality']
+    require(isinstance(quality, str) and quality in FEATURES, 'Unsupported generated quality class')
+    require(schema == SCHEMA_V2 or quality != 'classified-scan-points', 'Point-only quality requires v2 evidence')
+    x, z = map(int, item['tile'].split('_'))
+    require(isinstance(item['world_offset_xz'], list) and item['world_offset_xz'] == [x * 512, z * 512] and
+            all(type(value) is int for value in item['world_offset_xz']) and
+            type(item['size_m']) is int and item['size_m'] == 512 and
+            finite(item['metres_per_block']) and item['metres_per_block'] == 1 and
+            item['region_file'] == f'r.{x}.{z}.mca', 'Coordinate or scale claims differ')
+    require(checksum(item['receipt_sha256']) and checksum(item['region_sha256']), 'Immutable receipt/region hash required')
+    require(integer(item['chunks'], 1, 1024) and integer(item['roof_source_cells'], 0, 512 ** 2),
+            'Actual bounded chunk/roof counts required')
+    grid = item['source_grid']
+    require(isinstance(grid, dict) and set(grid) == {'west', 'north', 'size'} and
+            all(finite(value) for value in grid.values()) and type(grid['size']) is int and grid['size'] == 512,
+            'Finite source grid required')
+    scan = item['scan']
+    require(isinstance(scan, dict) and not set(scan) - {'county', 'year'} and
+            ('county' not in scan or isinstance(scan['county'], str)) and
+            ('year' not in scan or integer(scan['year'], 1, 9999)), 'Primitive survey facts required')
+    require(type(item['real_facade_photo_colors_applied']) is int and item['real_facade_photo_colors_applied'] == 0 and
+            item['client_visual_verified'] is False and item['privacy_audit'] == PRIVACY,
+            'Unsupported appearance/visual/privacy claim')
+    if schema == SCHEMA_V2:
+        if quality == 'classified-scan-points':
+            require(item['roof_source_cells'] == 0 and scan == {}, 'Point-only data cannot claim paired roof surfaces')
+            validate_point_evidence(item['point_evidence'], frame)
+            require({key: item['point_evidence']['grid'][key] for key in ('west', 'north', 'size')} == grid,
+                    'Point and entry grids differ')
+            require(isinstance(frame, dict) and finite(frame.get('west')) and finite(frame.get('north')) and
+                    grid['west'] == frame['west'] + item['world_offset_xz'][0] and
+                    grid['north'] == frame['north'] - item['world_offset_xz'][1],
+                    'Point source grid must match the canonical tile position')
+        else:
+            require(item['point_evidence'] is None, 'Legacy classes must not borrow point-only evidence')
+
+
+def should_replace(old, candidate):
+    require(isinstance(old, str) and isinstance(candidate, str) and old in FEATURES and candidate in FEATURES,
+            'Unsupported index quality class')
+    # Paired roofs and point-only observations are incomparable. Preserve either
+    # rather than discarding one kind of evidence during an apparent upgrade.
+    return FEATURES[old] <= FEATURES[candidate]
