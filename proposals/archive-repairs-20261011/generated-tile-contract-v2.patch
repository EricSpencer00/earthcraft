+"""Read-only admission of the existing point-only EPT profile; no geometry synthesis."""
+import gzip
+import hashlib
+import io
+import json
+from pathlib import Path
+import zlib
+
+import nbtlib
+import numpy as np
+
+from generated_tile_schema import require, integer, checksum, validate_point_evidence
+from point_geometry import voxelize
+from region_expansion import records, sha
+
+
+def occupied_point_cells(raw, cells):
+    """Check every admitted observed voxel against the actual generated blocks."""
+    grouped = {}
+    for x, y, z in cells:
+        grouped.setdefault((int(x) // 16, int(z) // 16), []).append((int(x), int(y), int(z)))
+    chunks = records(raw)
+    air = {'minecraft:air', 'minecraft:cave_air', 'minecraft:void_air', 'minecraft:water', 'minecraft:lava'}
+    for (cx, cz), values in grouped.items():
+        slot = cz * 32 + cx
+        require(slot in chunks, 'Observed point chunk absent')
+        record = chunks[slot][0]
+        payload = record[5:]
+        decoded = zlib.decompress(payload) if record[4] == 2 else gzip.decompress(payload) if record[4] == 1 else payload
+        tag = nbtlib.File.parse(io.BytesIO(decoded))
+        sections = {int(section['Y']): section for section in tag.get('sections', [])}
+        for x, y, z in values:
+            require(y // 16 in sections, 'Observed point section absent')
+            state = sections[y // 16].get('block_states')
+            require(state is not None and len(state['palette']) > 0, 'Observed point block state absent')
+            palette = state['palette']
+            if len(palette) == 1:
+                index = 0
+            else:
+                bits = max(4, (len(palette) - 1).bit_length())
+                position = (y % 16) * 256 + (z % 16) * 16 + x % 16
+                words = state.get('data', [])
+                word = position // (64 // bits)
+                require(word < len(words), 'Observed point packing differs')
+                index = (int(words[word]) & ((1 << 64) - 1)) >> ((position % (64 // bits)) * bits) & ((1 << bits) - 1)
+            require(index < len(palette) and str(palette[index]['Name']) not in air,
+                    'Observed point voxel missing from generated region')
+
+
+def point_only_evidence(root, world, meta, proof, frame, raw):
+    root, world = Path(root), Path(world)
+    require(proof.get('raw_points_acquired') is True and proof.get('facade_measured') is False and
+            proof.get('vertical_check_reference') == 'LQ terrain; absolute vertical datum unverified',
+            'Explicit point-only receipt and datum limitation required')
+    report = meta.get('point_geometry_source')
+    require(isinstance(report, dict) and report.get('extrusion') is False and report.get('llm_used') is False and
+            meta.get('building_geometry') == 'Observed 3D point voxels; no heightfield extrusion',
+            'Point-only geometry must remain observed voxels, without inferred extrusion')
+    source = report.get('source_manifest')
+    require(isinstance(source, dict) and source.get('schema') == 'earthcraft-classified-ept-building-crop-v1' and
+            source == meta.get('source', {}).get('classified_point_receipt'), 'Frozen point source receipt differs')
+    require(integer(source.get('classified_class6_points'), 1) and
+            source['classified_class6_points'] == source.get('building_points') and
+            type(source.get('associated_class1_points')) is int and source['associated_class1_points'] == 0 and
+            source.get('point_admission') == 'Provider class 6 only', 'Direct class-6 source counts differ')
+    assets = source.get('assets')
+    require(isinstance(assets, list) and assets and
+            all(isinstance(asset, dict) and isinstance(asset.get('key'), str) and asset['key'] and
+                checksum(asset.get('sha256')) and integer(asset.get('points')) and integer(asset.get('building_points_in_crop')) and
+                asset['building_points_in_crop'] <= asset['points'] and
+                type(asset.get('associated_class1_points')) is int and asset['associated_class1_points'] == 0
+                for asset in assets) and len({asset['key'] for asset in assets}) == len(assets) and
+            sum(asset['building_points_in_crop'] for asset in assets) == source['classified_class6_points'],
+            'Original point asset counts differ')
+    project = source.get('project')
+    require(isinstance(project, str) and project and project not in {'.', '..'} and '/' not in project and '\\' not in project,
+            'Task-scoped public point project required')
+    crop = root / 'point-only-crops' / project
+    require(crop.resolve().is_relative_to((root / 'point-only-crops').resolve()), 'Point source outside task crop')
+    files = [crop / 'manifest.json', crop / 'points.npz', world / 'point-geometry.json',
+             world / 'point-voxels.npy', world / 'block-verification.json']
+    require(all(path.is_file() and not path.is_symlink() for path in files) and
+            not any(parent.is_symlink() for path in files for parent in path.parents), 'Frozen regular point evidence required')
+    require(json.loads(files[0].read_text()) == source and sha(files[1]) == source.get('points_sha256') and
+            json.loads(files[2].read_text()) == report, 'Point evidence bytes changed')
+    grid = {key: meta['source'][key] for key in ('crs', 'west', 'north', 'size')}
+    require(source.get('grid') == grid and source.get('output_horizontal_crs') == frame.get('crs') and
+            meta.get('vertical_offset_m') == frame.get('vertical_offset_m'), 'Point/world coordinates differ')
+    with np.load(files[1], allow_pickle=False) as data:
+        require(data.files == ['xyz'], 'Canonical EPT point array required')
+        xyz = data['xyz']
+    cells = np.load(files[3], allow_pickle=False)
