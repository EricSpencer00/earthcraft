+def alter_manifest(raw, transform):
+    out = io.BytesIO()
+    with tarfile.open(fileobj=io.BytesIO(raw)) as original, tarfile.open(fileobj=out, mode='w') as changed:
+        for member in original.getmembers():
+            body = original.extractfile(member).read()
+            if member.name == 'manifest.json':
+                manifest = json.loads(body); transform(manifest)
+                body = json.dumps(manifest, sort_keys=True).encode()
+            item = tarfile.TarInfo(member.name); item.size = len(body); item.mode = 0o644
+            changed.addfile(item, io.BytesIO(body))
+    return out.getvalue()
