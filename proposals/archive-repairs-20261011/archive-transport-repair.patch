+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import {command,archiveSshOptions} from '../scripts/archive_command.mjs';
+import {sshOptions} from '../scripts/mini_transport.mjs';
+
+test('bounded binary stdin/stdout preserves exact archive bytes',async()=>{
+ const bytes=Buffer.from([0,255,128,10,13,65]);
+ const result=await command(process.execPath,['-e',
+  "const chunks=[];process.stdin.on('data',x=>chunks.push(x));process.stdin.on('end',()=>process.stdout.write(Buffer.concat(chunks)));"],
+  bytes,2000,{binary:true,maxBytes:bytes.length});
+ assert.deepEqual(result,bytes);
+});
+
+async function gone(pid){
+ for(let i=0;i<40;i++){
+  try{process.kill(pid,0);}catch(error){if(error.code==='ESRCH')return true;throw error;}
+  await new Promise(resolve=>setTimeout(resolve,25));
+ }
+ return false;
+}
+
+test('timeout settles when an exited parent leaves inherited pipes open, and kills its owned descendant',async()=>{
+ const root=await fs.mkdtemp(path.join(os.tmpdir(),'earthcraft-command-test-')),file=path.join(root,'child.pid');
+ let pid;
+ try{
+  const source="const {spawn}=require('node:child_process');const fs=require('node:fs');"+
+   "const c=spawn(process.execPath,['-e',\"process.on('SIGTERM',()=>{});setInterval(()=>{},1000);\"],{stdio:['ignore',process.stdout,process.stderr]});"+
+   "fs.writeFileSync(process.argv[1],String(c.pid));process.exit(0);";
+  const started=Date.now();
+  await assert.rejects(command(process.execPath,['-e',source,file],null,500,{killGraceMs:100}),
+   error=>error.code==='ETIMEDOUT'&&error.timedOut===true);
+  assert(Date.now()-started<2500,'Inherited writer exceeded the timeout settlement bound');
+  pid=Number(await fs.readFile(file,'utf8'));assert(await gone(pid),'Owned descendant survived timeout cleanup');
+ }finally{
+  if(pid){try{process.kill(pid,'SIGKILL');}catch(error){if(error.code!=='ESRCH')throw error;}}
+  await fs.rm(root,{recursive:true,force:true});
+ }
+});
+
+test('SIGTERM-resistant foreground process is killed within the grace bound',async()=>{
+ const root=await fs.mkdtemp(path.join(os.tmpdir(),'earthcraft-command-test-')),file=path.join(root,'child.pid');
+ let pid;
+ try{
+  const started=Date.now();
+  await assert.rejects(command(process.execPath,['-e',
+   "require('node:fs').writeFileSync(process.argv[1],String(process.pid));process.on('SIGTERM',()=>{});setInterval(()=>{},1000);",file],
+   null,500,{killGraceMs:100}),error=>error.code==='ETIMEDOUT'&&error.timedOut===true);
+  assert(Date.now()-started<2500);
+  pid=Number(await fs.readFile(file,'utf8'));assert(await gone(pid));
+ }finally{
+  if(pid){try{process.kill(pid,'SIGKILL');}catch(error){if(error.code!=='ESRCH')throw error;}}
+  await fs.rm(root,{recursive:true,force:true});
+ }
+});
+
+test('oversized stdout rejects rather than accepting a partial archive',async()=>{
+ await assert.rejects(command(process.execPath,['-e',
+  "process.stdout.write(Buffer.alloc(65536));setInterval(()=>{},1000);"],null,2000,{maxBytes:1024,killGraceMs:100}),
+  error=>error.code==='ERR_OUTPUT_LIMIT'&&!error.timedOut);
+});
+
+test('nonzero and spawn failures preserve executable and exit classification',async()=>{
+ await assert.rejects(command(process.execPath,['-e','process.exit(255)'],null,2000),
+  error=>error.executable===process.execPath&&error.code===255);
+ await assert.rejects(command('/nonexistent-earthcraft-test-executable',[],null,2000),
+  error=>error.code==='ENOENT'&&error.executable==='/nonexistent-earthcraft-test-executable');
+});
+
+test('archive options disable multiplexing without changing ordinary transport settings',async()=>{
+ const options=archiveSshOptions('/tmp/earthcraft-test-control');
+ assert(options.includes('BatchMode=yes'));assert(options.includes('ConnectTimeout=60'));assert(options.includes('AddressFamily=inet'));
+ assert(options.includes('ControlMaster=no'));assert(options.includes('ControlPersist=no'));assert(options.includes('ControlPath=none'));
+ assert(sshOptions('/tmp/earthcraft-test-control').includes('ControlMaster=auto'));
+ // -G is configuration expansion only; /dev/null and disabled identities avoid credentials and network work.
+ const expanded=await command('/usr/bin/ssh',['-G','-F','/dev/null','-o','IdentityAgent=none',
+  '-o','IdentityFile=none','-o','CertificateFile=none',...options,'unused.invalid'],null,2000);
+ const values=Object.fromEntries(expanded.trim().split('\n').map(line=>[line.split(' ')[0],line.slice(line.indexOf(' ')+1)]));
+ assert.equal(values.controlmaster,'false');assert.equal(values.controlpersist,'no');assert(!values.controlpath||values.controlpath==='none');
+});
